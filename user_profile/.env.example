# ============================================
# 账号画像系统 环境变量配置模板
# ============================================
# 复制此文件为 .env 并根据实际环境修改

# 项目根目录（可选，默认自动检测）
# USER_PROFILE_ROOT=/path/to/user_profile

# 日志级别（可选，默认 INFO）
# LOG_LEVEL=INFO

# RocketMQ 地址（可选，覆盖默认配置）
# MQ_URL=yqms-rocketmq-broker1-master.istarshine.net.cn:9876;yqms-rocketmq-broker2-master.istarshine.net.cn:9876

# Redis 地址（可选，覆盖默认配置）
# REDIS_URL_BLOOM=redis://192.168.187.3/5
# REDIS_URL_VERIFIED=redis://192.168.187.3/2
# REDIS_URL_QUCHONG=redis://192.168.19.5/1

# OpenSearch 地址（可选，覆盖默认配置）
# OPENSEARCH_HOSTS=https://opensearch-o-00o160its7w7.escloud.ivolces.com:9200

# MySQL 配置（可选，覆盖默认配置）
# MYSQL_HOST=192.168.19.65
# MYSQL_USER=buser
# MYSQL_PASSWORD=p3jnmja3
# MYSQL_DATABASE=user_profile
