FROM zhxgharbor.istarshine.com/dflow/centos7_rmqclient:3.6

# 时区
RUN yum install -y tzdata && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

RUN pip3.6 install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple/

# 安装依赖
RUN pip3.6 install --no-cache-dir \
    requests \
    ujson \
    loguru \
    arrow \
    pandas \
    numpy \
    -i https://pypi.tuna.tsinghua.edu.cn/simple/

# 复制项目文件
COPY data_command_transfer_api/main_v2.py /app/main.py
COPY data_command_transfer_api/config.py /app/
COPY data_command_transfer_api/utils/__init__.py /app/utils/
COPY data_command_transfer_api/utils/field_mapping.py /app/utils/
COPY data_command_transfer_api/utils/mq_toolkit.py /app/utils/
COPY data_command_transfer_api/utils/daoding_body.py /app/utils/
COPY data_command_transfer_api/utils/download_API.py /app/utils/
COPY ca.cer /app/

RUN mkdir -p /app/logs

WORKDIR /app
CMD ["python3.6", "main.py"]
